# Copiar a .env y ajustar en local. Nunca versionar .env.
#
#   cp .env.example .env
#
# Ninguno de estos valores es un secreto real: son valores de desarrollo local.

# --- Base de datos ---
DB_NAME=devtrack
DB_USERNAME=devtrack
DB_PASSWORD=devtrack
DB_PORT=5432
# URL usada por la aplicacion ejecutada en el host (no dentro de Docker).
DB_URL=jdbc:postgresql://localhost:5432/devtrack

# --- Aplicacion ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Seguridad ---
# OBLIGATORIO y con un minimo de 32 caracteres: si falta o es corto, la aplicacion
# NO arranca (fail-fast, ADR-0003 y riesgo R-04).
# Genera uno con:  head -c 48 /dev/urandom | base64
DEVTRACK_JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-bytes
